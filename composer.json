{
    "name": "lcmialichi/php-gpu-tensors",
    "type": "php-ext",
    "description": "Native PHP tensor extension with pluggable backend contracts and CUDA-accelerated computing.",
    "license": "MIT",
    "keywords": [
        "php-extension",
        "cuda",
        "nvidia",
        "gpu-computing",
        "gpu-tensors",
        "tensors",
        "machine-learning",
        "tensor",
        "deep-learning",
        "numerical-computing"
    ],
    "require": {
        "php": ">=8.1 <8.6"
    },
    "replace": {
        "ext-phptensors": "*"
    },
    "php-ext": {
        "extension-name": "phptensors",
        "support-zts": true,
        "os-families": [
            "linux"
        ],
        "configure-options": [
            {
                "name": "with-cuda",
                "description": "Optional CUDA Toolkit path; omit it to build the CPU-only backend.",
                "needs-value": true
            }
        ]
    }
}
